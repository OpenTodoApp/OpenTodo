{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "import_job",
  "description": "ot import --json: the finished import job as the server reports it (GET /api/v1/import/jobs/{id}). With --dry-run the dry_run document is printed instead, with the server's preview.",
  "type": "object",
  "required": ["id", "format", "status", "options", "totals", "errors"],
  "properties": {
    "id": {"type": "string"},
    "format": {"type": "string"},
    "status": {"enum": ["done", "failed", "undone"]},
    "options": {"type": "object", "description": "the options the job ran with; workspace is the target workspace's id when one was chosen"},
    "totals": {
      "type": "object",
      "required": ["rows", "create", "update", "skip", "error"],
      "properties": {
        "rows": {"type": "integer"},
        "create": {"type": "integer"},
        "update": {"type": "integer"},
        "skip": {"type": "integer"},
        "error": {"type": "integer"},
        "newProjects": {"type": "integer"},
        "newLabels": {"type": "integer"}
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason"],
        "properties": {"row": {"type": "integer"}, "sourceId": {"type": "string"}, "reason": {"type": "string"}}
      }
    },
    "message": {"type": "string"},
    "createdAt": {"type": "integer"},
    "finishedAt": {"type": ["integer", "null"]}
  }
}
