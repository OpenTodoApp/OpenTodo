{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error",
  "description": "Printed on stdout with --json when a command fails; stderr gets one line starting with ot:.",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message", "exit"],
      "properties": {
        "code": {"type": "string", "description": "stable reason, see error_codes"},
        "message": {"type": "string"},
        "exit": {"type": "integer", "minimum": 1, "maximum": 5, "description": "the process exit code"},
        "retry_after_seconds": {"type": "integer"}
      }
    }
  }
}
