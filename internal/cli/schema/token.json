{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "token",
  "description": "An API token as listed; the secret is never part of it.",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "scope": {"enum": ["full", "read", "agent"]},
    "createdAt": {"type": "number"},
    "lastUsedAt": {"type": ["number", "null"]}
  }
}
