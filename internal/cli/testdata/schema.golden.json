      "args": [
        {
          "name": "ref",
          "required": true,
          "repeatable": false
        }
      ],
      "flags": [
        {
          "name": "title",
          "type": "string",
          "description": "new title"
        },
        {
          "name": "project",
          "type": "string",
          "description": "project name or id (edit: none moves to the Inbox)"
        },
        {
          "name": "due",
          "type": "string",
          "description": "YYYY-MM-DD, today, tomorrow or a weekday (edit: none clears)"
        },
        {
          "name": "time",
          "type": "string",
          "description": "due time HH:MM"
        },
        {
          "name": "priority",
          "type": "int",
          "enum": [
            "1",
            "2",
            "3",
            "4"
          ],
          "description": "1 (highest) to 4 (lowest)"
        },
        {
          "name": "label",
          "type": "string_list",
          "description": "label name or id, repeatable (created when missing; edit replaces the list)"
        },
        {
          "name": "note",
          "type": "string",
          "description": "description"
        }
      ],
      "writes": true,
      "destructive": false,
      "dry_run": true,
      "idempotency_key": false,
      "output_schema": {
        "$ref": "#/schemas/task"
      }
    },
    {
      "name": "export",
