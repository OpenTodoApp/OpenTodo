            },
            "message": {
              "type": "string"
            },
            "exit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "the process exit code"
            },
            "retry_after_seconds": {
              "type": "integer"
            }
          }
        }
      }
    },
    "export_file": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
