          "type": "string",
          "description": "full, read or agent; empty for a server that does not report it"
        },
        "writes_allowed": {
          "type": "boolean",
          "description": "agent tokens: whether both assistant switches are on"
        },
        "writes_denied": {
          "type": "string",
