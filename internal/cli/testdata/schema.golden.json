{
  "cli_version": "dev",
  "commands": [
    {
      "name": "add",
      "summary": "create a task and print its id",
      "args": [
        {
          "name": "title",
          "required": true,
          "repeatable": true
        }
      ],
      "flags": [
        {
          "name": "project",
          "type": "string",
          "description": "project name or id (edit: none moves to the Inbox)"
        },
        {
          "name": "due",
          "type": "string",
          "description": "YYYY-MM-DD, today, tomorrow or a weekday (edit: none clears)"
        },
        {
          "name": "time",
          "type": "string",
          "description": "due time HH:MM"
        },
        {
          "name": "priority",
          "type": "int",
          "enum": [
            "1",
            "2",
            "3",
            "4"
          ],
          "description": "1 (highest) to 4 (lowest)"
        },
        {
          "name": "label",
          "type": "string_list",
          "description": "label name or id, repeatable (created when missing; edit replaces the list)"
        },
        {
          "name": "note",
          "type": "string",
          "description": "description"
        },
        {
          "name": "idempotency-key",
          "type": "string",
          "description": "1-128 characters of [A-Za-z0-9._:-]; running again with the same key returns the same entity instead of creating another"
        }
      ],
      "writes": true,
      "destructive": false,
      "dry_run": true,
      "idempotency_key": true,
      "output_schema": {
        "$ref": "#/schemas/task"
      }
    },
    {
      "name": "auth logout",
      "summary": "revoke the stored token on the server and remove it locally",
      "args": [],
      "flags": [
        {
          "name": "yes",
          "short": "y",
          "type": "bool",
          "description": "confirm a destructive command (required off a terminal and with --json)"
        }
      ],
      "writes": true,
      "destructive": true,
      "dry_run": true,
      "idempotency_key": false,
      "output_schema": {
        "$ref": "#/schemas/auth_result"
      }
    },
    {
      "name": "auth set-token",
      "summary": "store a token created elsewhere in the profile",
      "args": [
        {
          "name": "token",
          "required": true,
          "repeatable": false
        }
      ],
      "flags": [],
      "writes": true,
      "destructive": false,
      "dry_run": true,
      "idempotency_key": false,
      "output_schema": {
        "$ref": "#/schemas/auth_result"
      }
    },
    {
      "name": "auth status",
      "summary": "show the server, account, token name and scope",
      "args": [],
      "flags": [],
      "writes": false,
      "destructive": false,
      "dry_run": false,
      "idempotency_key": false,
      "output_schema": {
        "$ref": "#/schemas/auth_status"
      }
    },
    {
      "name": "done",
      "summary": "complete one or more tasks",
