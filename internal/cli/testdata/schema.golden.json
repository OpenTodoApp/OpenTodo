        {
          "name": "ref",
          "required": true,
          "repeatable": true
        }
      ],
      "flags": [],
      "writes": true,
      "destructive": false,
      "dry_run": true,
      "idempotency_key": false,
      "output_schema": {
        "oneOf": [
          {
            "$ref": "#/schemas/task_result"
          },
          {
            "items": {
              "$ref": "#/schemas/task_result"
            },
            "type": "array"
          }
        ]
      }
    },
    {
      "name": "edit",
