// OpenTodo theme template.
// Lines that start with // are notes.
{
  "$schema": "https://raw.githubusercontent.com/OpenTodoApp/OpenTodo/main/docs/themes/opentodo-theme.schema.json",
  "opentodoTheme": 1, // Keep 1.
  "id": "opentodo-light", // An id.
  "name": "OpenTodo Light", // A name.
  "author": "OpenTodo contributors", // You.
  "licence": "AGPL-3.0-only", // SPDX.
  "source": "web/src/index.css", // Text.
  "kind": "light", // light or dark.
  "seeds": {
    // Base colours.
    "canvas": "oklch(0.9542 0.0034 247.86)", // The canvas seed.
    "surface": "oklch(1 0 0)", // The surface seed.
    "text": "oklch(0.2126 0.0067 258.37)", // The text seed.
    "accent": "oklch(0.5081 0.1049 165.61)", // The accent seed.
    // Status colours.
    // "success": "#047857", // The success seed.
    // "warning": "#8a5200", // The warning seed.
    // "danger": "#bd2f2a", // The danger seed.
    // "info": "#2860c0", // The info seed.
  },
  "tokens": {
    // Every other colour.
    // — surfaces —
    // "raised": "#f7f7f7", // raised
    // "sunken": "#f1f3f5", // sunken
    // "pop": "#ffffff", // pop
    // "hover": "#f8f8f8", // hover
    // "selected": "#e7e9ec", // selected
    // "selected-row": "#f1f3f5", // selected-row
    // "sidebar": "#eef0f2", // sidebar
    // — text —
    // "text-strong": "#17191c", // text-strong
    // "muted": "#5c6169", // muted
    // "faint": "#62686f", // faint
    // — lines —
    // "border": "#dee0e3", // border
