    // "border-input": "#7c8799", // border-input
    // "line-strong": "#d4d7db", // line-strong
    // — accent —
    // "accent-hover": "#036146", // accent-hover
    // "on-accent": "#ffffff", // on-accent
    // "accent-text": "#047857", // accent-text
    // "accent-soft": "#e9f1ed", // accent-soft
    // "accent-soft-text": "#02573e", // accent-soft-text
    // "focus": "#3f8c6e", // focus
    // — status —
    // "success-soft": "#ecfdf5", // success-soft
    // "success-soft-text": "#065f46", // success-soft-text
    // "warning-soft": "#fffbeb", // warning-soft
    // "warning-soft-text": "#92400e", // warning-soft-text
    // "danger-soft": "#fef2f2", // danger-soft
    // "danger-soft-text": "#991b1b", // danger-soft-text
    // "info-soft": "#f0f9ff", // info-soft
    // "info-soft-text": "#075985", // info-soft-text
    // — priorities —
    // "p1": "#dc2626", // p1
    // "p1-soft": "#fef2f2", // p1-soft
    // "p2": "#ea580c", // p2
    // "p2-soft": "#fff7ed", // p2-soft
    // "p3": "#2563eb", // p3
    // "p3-soft": "#eff6ff", // p3-soft
    // "p4": "#64748b", // p4
    // "p4-soft": "#f8fafc", // p4-soft
