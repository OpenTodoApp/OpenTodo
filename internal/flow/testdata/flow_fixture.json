{
  "about": "Shared vectors for the available-task rule (OpenSpec change project-flow-modes): web/src/lib/flow.ts and internal/flow both evaluate this file; change them together. Missing task fields read as their defaults. expected.available lists every available task; expected.waits maps every task waiting in sequence to what holds it (task:<id> or section:<id>); every other task is neither.",
  "cases": [
    {
      "name": "sequential project: one step at a time, subtasks follow their step",
      "today": "2026-10-30",
      "projects": [{ "id": "move", "flow_mode": "sequential" }],
      "sections": [],
      "tasks": [
        { "id": "van", "project_id": "move", "position": 1 },
        { "id": "van-call", "project_id": "move", "parent_id": "van", "position": 1 },
        { "id": "pack", "project_id": "move", "position": 2 },
        { "id": "boxes", "project_id": "move", "parent_id": "pack", "position": 1 },
        { "id": "keys", "project_id": "move", "position": 3 }
      ],
      "expected": {
        "available": ["van", "van-call"],
        "waits": { "pack": "task:van", "boxes": "task:van", "keys": "task:van" }
      }
    },
    {
      "name": "sequential project: completing a step offers the next",
      "today": "2026-10-30",
      "projects": [{ "id": "move", "flow_mode": "sequential" }],
      "sections": [],
      "tasks": [
        { "id": "van", "project_id": "move", "position": 1, "completed_at": 1790000000000 },
        { "id": "van-call", "project_id": "move", "parent_id": "van", "position": 1 },
        { "id": "pack", "project_id": "move", "position": 2 },
        { "id": "boxes", "project_id": "move", "parent_id": "pack", "position": 1 },
        { "id": "keys", "project_id": "move", "position": 3 }
      ],
      "expected": {
        "available": ["boxes", "pack", "van-call"],
        "waits": { "keys": "task:pack" }
      }
    },
    {
      "name": "sequential project: a reorder decides, ties broken by id",
      "today": "2026-10-30",
      "projects": [{ "id": "move", "flow_mode": "sequential" }],
      "sections": [],
      "tasks": [
        { "id": "van", "project_id": "move", "position": 1, "completed_at": 1790000000000 },
        { "id": "pack", "project_id": "move", "position": 2 },
        { "id": "keys", "project_id": "move", "position": 1.5 },
        { "id": "b-same", "project_id": "move", "position": 7 },
        { "id": "a-same", "project_id": "move", "position": 7 }
      ],
      "expected": {
        "available": ["keys"],
        "waits": { "pack": "task:keys", "a-same": "task:keys", "b-same": "task:keys" }
      }
    },
    {
      "name": "sequential project: a parallel section is one step, a following section is one by one",
      "today": "2026-10-30",
      "projects": [{ "id": "launch", "flow_mode": "sequential" }],
      "sections": [
        { "id": "prepare", "project_id": "launch", "position": 1, "flow_mode": "parallel" },
        { "id": "ship", "project_id": "launch", "position": 2, "flow_mode": "" }
      ],
      "tasks": [
        { "id": "p1", "project_id": "launch", "section_id": "prepare", "position": 1 },
        { "id": "p2", "project_id": "launch", "section_id": "prepare", "position": 2 },
        { "id": "p3", "project_id": "launch", "section_id": "prepare", "position": 3 },
        { "id": "s1", "project_id": "launch", "section_id": "ship", "position": 1 },
        { "id": "s2", "project_id": "launch", "section_id": "ship", "position": 2 }
      ],
      "expected": {
        "available": ["p1", "p2", "p3"],
        "waits": { "s1": "section:prepare", "s2": "section:prepare" }
      }
    },
    {
      "name": "sequential project: once the parallel section is done, the next section offers its first task",
      "today": "2026-10-30",
      "projects": [{ "id": "launch", "flow_mode": "sequential" }],
      "sections": [
        { "id": "prepare", "project_id": "launch", "position": 1, "flow_mode": "parallel" },
        { "id": "ship", "project_id": "launch", "position": 2 }
      ],
      "tasks": [
        { "id": "p1", "project_id": "launch", "section_id": "prepare", "position": 1, "completed_at": 1790000000000 },
        { "id": "p2", "project_id": "launch", "section_id": "prepare", "position": 2, "completed_at": 1790000000000 },
        { "id": "p3", "project_id": "launch", "section_id": "prepare", "position": 3, "deleted_at": 1790000000000 },
        { "id": "s1", "project_id": "launch", "section_id": "ship", "position": 1 },
        { "id": "s2", "project_id": "launch", "section_id": "ship", "position": 2 }
      ],
      "expected": {
        "available": ["s1"],
        "waits": { "s2": "task:s1" }
      }
    },
    {
      "name": "sequential project: a sequential section holds the sections after it; deleted sections do not count",
      "today": "2026-10-30",
      "projects": [{ "id": "trip", "flow_mode": "sequential" }],
      "sections": [
        { "id": "b", "project_id": "trip", "position": 2 },
        { "id": "a", "project_id": "trip", "position": 1, "flow_mode": "sequential" },
        { "id": "gone", "project_id": "trip", "position": 0, "deleted_at": 1790000000000 }
      ],
      "tasks": [
        { "id": "a1", "project_id": "trip", "section_id": "a", "position": 1 },
        { "id": "a2", "project_id": "trip", "section_id": "a", "position": 2 },
        { "id": "b1", "project_id": "trip", "section_id": "b", "position": 1 },
        { "id": "loose", "project_id": "trip", "section_id": "gone", "position": 9, "completed_at": 1790000000000 }
      ],
      "expected": {
        "available": ["a1"],
        "waits": { "a2": "task:a1", "b1": "section:a" }
      }
    },
