# Build outputs
/bin/
/dist/
/internal/web/dist/*
!/internal/web/dist/.gitkeep
/web/dist/
/web/dev-dist/
/obsidian/dist/
/obsidian/node_modules/
/obsidian/review/node_modules/

# Dependencies
/web/node_modules/
/web/node_modules
# A test runner started from the repository root writes its cache here.
/node_modules/
__pycache__/

# Runtime data
/data/
*.db
*.db-wal
*.db-shm

# Environment
.env
.env.local

# Tooling
coverage.out
/perf-report/
gosec.sarif
*.log
.DS_Store
/web/.vite/
/web/playwright-report/
/web/test-results/
/layout-report/
/safe-area-report/
/ux-audit-report/
/eval-report/

# Agent worktrees
/.claude/worktrees/
/.playwright-mcp/
/docs-report/
/web/storybook-static/
/tmp/
# extension-v2: written from extension/manifest.src.json for loading the folder unpacked
/extension/manifest.json
# The in-app help, built from docs/ by the web app's scripts (`npm run help`) before
# build, dev, test and typecheck: not committed, so docs edits in parallel pull
# requests never conflict over it.
/web/src/generated/help.json
