    "react-native": "0.88.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.9"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.20",
    "dexie": "4.4.7",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
