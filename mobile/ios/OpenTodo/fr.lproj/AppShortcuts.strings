/* Siri phrases of the App Shortcuts (apple-shortcuts D4). Every phrase names the app with
   ${applicationName}. A String Catalog needs iOS 17, so these are .strings files. */

"Open Today in ${applicationName}" = "Ouvre Aujourd’hui dans ${applicationName}";
"Open quick add in ${applicationName}" = "Ouvre l’ajout rapide dans ${applicationName}";
"What do I have today in ${applicationName}" = "Qu’est-ce que j’ai aujourd’hui dans ${applicationName}";
"What's on today in ${applicationName}" = "Qu’est-ce qui est prévu aujourd’hui dans ${applicationName}";
