    "No answer from that address. Check the address and your connection.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antwort von dieser Adresse. Prüfe Adresse und Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay respuesta en esa dirección. Comprueba la dirección y la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse à cette adresse. Vérifiez l’adresse et votre connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna risposta da questo indirizzo. Controlla l’indirizzo e la connessione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem resposta nesse endereço. Verifique o endereço e a ligação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adresten yanıt alınamadı. Adresi ve bağlantınızı kontrol edin."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "该地址没有响应。请检查地址和你的连接。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen antwoord van dat adres. Controleer het adres en je verbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak odpowiedzi z tego adresu. Sprawdź adres i połączenie."
          }
        }
      }
    },
