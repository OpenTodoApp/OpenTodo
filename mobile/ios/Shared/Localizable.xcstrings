    "Changes that have not reached the server are lost. Your tasks stay on the server.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen, die den Server noch nicht erreicht haben, gehen verloren. Deine Aufgaben bleiben auf dem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios que aún no han llegado al servidor se pierden. Tus tareas siguen en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications qui n’ont pas encore atteint le serveur sont perdues. Vos tâches restent sur le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche che non hanno ancora raggiunto il server vanno perse. Le tue attività restano sul server."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações que ainda não chegaram ao servidor perdem-se. As suas tarefas ficam no servidor."
          }
        }
      }
    },
