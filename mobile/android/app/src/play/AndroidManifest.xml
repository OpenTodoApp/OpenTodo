<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play build only (OpenSpec change play-location-later; -Popentodo.play=true, the AAB):
     location reminders wait for Play's background-location review, so the location permissions
     are removed from the merged manifest. The APK for GitHub and F-Droid never reads this file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
</manifest>
