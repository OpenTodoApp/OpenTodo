<?xml version="1.0" encoding="utf-8"?>
<!-- A day of the month shown in the Calendar widget; the dot shows when it has open tasks.
     widget_calendar_other (another month) and widget_calendar_today differ only in colour and ring,
     so no colour is set from code (#966). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/day_number"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/day_dot"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginTop="1dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_dot" />
</LinearLayout>
