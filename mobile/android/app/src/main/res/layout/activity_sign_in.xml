<?xml version="1.0" encoding="utf-8"?>
<!-- First-run sign-in through a login wall: the server in a web view with the site bar and
     no bridge; it closes by itself once the health check passes (android-sign-in-flows). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sign_in_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/view_site_bar" />

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
