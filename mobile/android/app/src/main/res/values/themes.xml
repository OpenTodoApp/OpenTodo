<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenTodo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- MainActivity's window (shell-first-paint): its background is the launch screen, the
         icon over the canvas colour, which shows until the page can be drawn. Android 12 and
         later: values-v31. -->
    <style name="Theme.OpenTodo.Launch">
        <item name="android:windowBackground">@drawable/launch</item>
    </style>

    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- The Completed widget's days (completed-widget D2): a bar over a weekday letter. -->
    <style name="WidgetDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WidgetBar" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:max">100</item>
        <item name="android:progressDrawable">@drawable/widget_bar</item>
    </style>

    <style name="WidgetDayLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
