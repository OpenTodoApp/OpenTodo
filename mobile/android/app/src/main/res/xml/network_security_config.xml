<?xml version="1.0" encoding="utf-8"?>
<!-- Trust the system and the user's own certificate authorities (a home server with a
     private authority), never anything else; plain http is allowed only for local
     addresses, which the first-run screen enforces (native-shells D3). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
