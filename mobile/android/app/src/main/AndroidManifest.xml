<?xml version="1.0" encoding="utf-8"?>
<!-- The OpenTodo Android shell (OpenSpec change native-shells). Permissions: design D8;
     store/permissions.txt must list the same set (checkStoreMetadata). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- android-urgent-alarms D4: an urgent reminder's alarm over the lock screen. On Android 14+
         from Google Play the user allows it (the Play declaration is in store/play-review.md). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The web view opens no microphone without it: getUserMedia fails at once, with
         the permission granted (GitHub issue 1582). Granted at install, no prompt. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- A phone without a microphone can still install the app; dictation is then unavailable. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Location reminders (location-reminders D4): platform proximity alerts only; the position stays on the phone. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Location is optional: the app installs on devices without it (no geofences there). -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- shell-push D2: the user's UnifiedPush distributor is found by its link activity or its
         REGISTER receiver. Package visibility only: no permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="unifiedpush" />
        </intent>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
        <!-- app-sso-system-browser: the browsers, and which of them offer Custom Tabs, so that
             single sign-on opens in one named browser, never in whatever app handles https. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenTodo">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OpenTodo.Launch"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- app-sso-system-browser: single sign-on returns from the browser with a single-use
                 code. Any app may open this address; only a sign-in this app started, with its
                 state and its PKCE verifier, is redeemed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opentodo" android:host="sso" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SignInActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- android-urgent-alarms D2: an urgent reminder's full-screen alarm, opened only by its own
             notification. Shown over the lock screen; no Recents entry, no back stack. -->
        <activity
            android:name=".AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true"
            tools:targetApi="o_mr1" />

        <!-- native-shells "Quick actions on the app icon": the shortcuts' target, so the task the
             system clears for a static shortcut is this one's and a running app keeps its state. -->
        <activity
            android:name=".ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".FocusEndReceiver" android:exported="false" />
        <receiver android:name=".NotificationActionReceiver" android:exported="false" />
        <receiver android:name=".QuickAddReceiver" android:exported="false" />
        <receiver android:name=".GeofenceReceiver" android:exported="false" />
        <!-- shell-push D2: the distributor's answers and messages. Exported, as UnifiedPush needs
             (the distributor is another app, and there is no permission to ask of it): every
             intent without the registration's own random token is ignored. -->
        <receiver android:name=".PushReceiver" android:exported="true" tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".TodayWidget" android:exported="false" android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today" />
        </receiver>
        <!-- android-widget-list D1, D2: the Today widget's list and its row taps. Not exported: the
             launcher reaches the service through the system's widget binding (BIND_REMOTEVIEWS),
             and the row-tap activity only through the widget's own pending intent. The activity
             draws nothing (Theme.NoDisplay) and leaves no trace in Recents or the back stack. -->
        <service
            android:name=".TodayListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <activity
            android:name=".WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- android-upcoming-calendar-widgets D3, D4: Upcoming (a list like Today's, through the same
             row-tap activity) and Calendar (a month grid; its arrows are broadcasts to its own receiver). -->
        <receiver android:name=".UpcomingWidget" android:exported="false" android:label="@string/widget_upcoming">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_upcoming" />
        </receiver>
        <service
            android:name=".UpcomingListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver android:name=".CalendarWidget" android:exported="false" android:label="@string/widget_calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_calendar" />
        </receiver>
        <receiver android:name=".QuickAddWidget" android:exported="false" android:label="@string/widget_quick_add">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_add" />
        </receiver>
        <receiver android:name=".CompletedWidget" android:exported="false" android:label="@string/widget_completed">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_completed" />
        </receiver>
    </application>
</manifest>
