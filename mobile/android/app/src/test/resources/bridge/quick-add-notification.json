      "json": "{\"on\":true,\"reply\":true}",
      "on": true,
      "reply": true
    },
    {
      "json": "{\"on\":false,\"reply\":true}",
      "on": false,
      "reply": true
    },
    {
      "json": "{\"on\":true,\"reply\":false}",
      "on": true,
      "reply": false
    },
    {
      "json": "{\"on\":false,\"reply\":false}",
      "on": false,
      "reply": false
    }
  ],
  "answers": [
    "on",
    "off",
    "denied"
  ],
