{
  "description": "Capabilities by kind of run (shell-reminders-on): visibleOnly is listed only by the app a person sees (biometric and geofences depend on the device and the store build and are not listed here), backgroundOnly only by a background run, both by either. methods names the capability each new method needs; expect is what the web app does in each run.",
  "visibleOnly": [
    "share",
    "links",
    "obsidian-links",
    "app-links",
    "system-bars",
    "microphone",
    "files",
    "haptics",
    "completion-sound",
    "alarm-settings",
    "urgent-alarms",
    "first-paint",
    "focus"
  ],
  "backgroundOnly": [
    "background"
  ],
  "both": [
    "reminders",
    "widgets",
    "push"
  ],
  "methods": {
    "openAlarmSettings": "alarm-settings",
    "allowUrgentAlarms": "urgent-alarms",
    "backgroundDone": "background",
    "playCompletionSound": "completion-sound",
    "painted": "first-paint"
  },
  "expect": {
    "visible": {
      "shellVisible": true,
      "openAlarmSettings": true,
      "allowUrgentAlarms": true,
      "backgroundDone": false
    },
    "background": {
      "shellVisible": false,
      "openAlarmSettings": false,
      "allowUrgentAlarms": false,
      "backgroundDone": true
    },
    "called": [
      "openAlarmSettings",
      "allowUrgentAlarms",
      "backgroundDone"
    ]
  }
}
