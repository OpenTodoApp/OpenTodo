{
  "manifest_version": 3,
  "name": "OpenTodo Capture",
  "short_name": "OpenTodo",
  "version": "0.4.0",
  "description": "Send the current page, its title and the selected text to the capture screen of your own OpenTodo server. No tracking, no network requests.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Add to OpenTodo",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Add the current page to OpenTodo"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "browser_specific_settings": {
    "gecko": {
      "id": "share-capture@opentodo",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
