{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx!",
    "src/page/main.tsx!",
    "src/sw.ts!",
    "public/*.js!",
    "scripts/**/*.mjs!",
    "src/app/screens.ts!",
    "src/**/*.stories.tsx",
    "src/**/*.test.{ts,tsx}",
    "src/test-setup.ts",
    "src/test/contractSetup.ts"
  ],
  "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.mjs!", "public/*.js!"],
  "ignore": ["src/generated/**"],
  "ignoreFiles": [
    "src/lib/testdata/**",
    "src/test/**",
    "src/**/*.testkit.tsx",
    "src/ui/test-utils.tsx",
    "src/app/stories/**",
    "src/ui/foundations/tokens.tsx",
    "src/ui/tokens/{contrast,css,notYetMigrated,resolve,styleLint}.ts",
    "src/lib/theme/catalogue/**",
    "src/lib/theme/{generate,sweep}.ts",
    "src/lib/voice/fakeRecognition.ts"
  ],
  "ignoreIssues": {
    "src/app/LocationReminderEditor.tsx": ["duplicates"],
    "src/app/calendar/SpanBand.tsx": ["duplicates"],
    "src/app/habits/HabitPage.tsx": ["duplicates"],
    "src/app/notes/NotesPage.tsx": ["duplicates"],
    "src/app/notes/NotesSidebar.tsx": ["duplicates"],
    "src/app/task-detail/HistoryTab.tsx": ["duplicates"],
    "src/app/views/DisplayOptionsBody.tsx": ["duplicates"],
    "src/page/NotePageScreen.tsx": ["duplicates"]
  },
  "ignoreExportsUsedInFile": true
}
