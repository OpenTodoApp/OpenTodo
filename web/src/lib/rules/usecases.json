        {"id": "c", "kind": "change_tasks", "in": {"tasks": {"ref": "b"}, "set": {"literal": {"due": "tomorrow"}}}}
      ],
      "expect": {"changed": {"s3": {"due": "2026-10-22"}, "s4": {"due": "2026-10-22"}, "s5": {"due": "2026-10-22"}}}
    },
