        {"id": "w6", "labels": ["lw"]}, {"id": "w7", "labels": ["lw"]}, {"id": "w8", "labels": ["lw"]}, {"id": "w9", "labels": ["lw"]}, {"id": "w10", "labels": ["lw"]}],
      "trigger": {"kind": "label.added", "label_id": "lw"}, "run_on": "w0",
      "steps": [
