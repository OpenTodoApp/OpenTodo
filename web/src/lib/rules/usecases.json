{
  "about": "The use-case suite of OpenSpec change routines-dynamic-data (design D12): realistic routines, each run by internal/rules (usecases_test.go) against seeded data with the expected writes, and type-checked by the TypeScript checker (usecases.test.ts). The clock is Wednesday 2026-10-21 12:00 UTC; tasks are listed in seed order (position). Seed tasks take title = id unless given; due and completed_on are dates.",
  "seeds": {
    "overdue": {
      "tasks": [
        {"id": "o1", "due": "2026-10-18"},
        {"id": "o2", "due": "2026-10-15"},
        {"id": "o3", "due": "2026-10-19"},
        {"id": "o4", "due": "2026-10-20"},
        {"id": "f1", "due": "2026-10-25"}
      ]
    }
  },
  "cases": [
    {
      "row": 1, "editor": true,
      "name": "When I run it, find my overdue tasks, pick the first, and comment",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "take", "in": {"list": {"ref": "a"}, "n": {"literal": 1}, "from": {"literal": "start"}}},
        {"id": "c", "kind": "add_comment", "in": {"task": {"ref": "b"}, "text": {"literal": "Still on it?"}}}
      ],
      "expect": {"comments": {"o1": ["Still on it?"]}}
    },
    {
      "row": 2, "editor": true,
      "name": "Same, but the last one",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "take", "in": {"list": {"ref": "a"}, "n": {"literal": 1}, "from": {"literal": "end"}}},
        {"id": "c", "kind": "add_comment", "in": {"task": {"ref": "b"}, "text": {"literal": "Still on it?"}}}
      ],
      "expect": {"comments": {"o4": ["Still on it?"]}}
    },
    {
      "row": 3, "editor": true,
      "name": "Same, on all of them (Pick all)",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "take", "in": {"list": {"ref": "a"}, "from": {"literal": "all"}}},
        {"id": "c", "kind": "add_comment", "in": {"task": {"ref": "b"}, "text": {"literal": "Still on it?"}}}
      ],
      "expect": {"comments": {"o1": ["Still on it?"], "o2": ["Still on it?"], "o3": ["Still on it?"], "o4": ["Still on it?"]}}
    },
    {
      "row": 3,
      "name": "Same, on all of them, straight from Find tasks",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "add_comment", "in": {"task": {"ref": "a"}, "text": {"literal": "Still on it?"}}}
      ],
      "expect": {"comments": {"o1": ["Still on it?"], "o2": ["Still on it?"], "o3": ["Still on it?"], "o4": ["Still on it?"]}}
    },
    {
      "row": 4, "editor": true,
      "name": "Same, on the three most overdue",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "sort", "in": {"list": {"ref": "a"}, "by": {"literal": "due"}, "direction": {"literal": "asc"}}},
        {"id": "c", "kind": "take", "in": {"list": {"ref": "b"}, "n": {"literal": 3}, "from": {"literal": "start"}}},
        {"id": "d", "kind": "add_comment", "in": {"task": {"ref": "c"}, "text": {"literal": "Still on it?"}}}
      ],
      "expect": {"comments": {"o1": ["Still on it?"], "o2": ["Still on it?"], "o3": ["Still on it?"]}}
    },
    {
      "row": 5, "editor": true,
      "name": "Find my overdue tasks, and for each: comment",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "repeat", "in": {"list": {"ref": "a"}}, "do": [
          {"id": "c", "kind": "add_comment", "in": {"task": {"ref": "item"}, "text": {"literal": "Still on it?"}}}]}
      ],
      "expect": {"comments": {"o1": ["Still on it?"], "o2": ["Still on it?"], "o3": ["Still on it?"], "o4": ["Still on it?"]}}
    },
    {
      "row": 6, "editor": true,
      "name": "Every Friday at 17:00, turn the lines of my Groceries project note into tasks in Errands",
      "projects": [{"id": "groc", "name": "Groceries", "description": "- oat milk\n- [ ] apples\n"}, {"id": "errands", "name": "Errands"}],
      "trigger": {"kind": "schedule", "at": "17:00", "weekdays": [5]},
      "steps": [
        {"id": "a", "kind": "note_text", "in": {"of": {"literal": {"project": "groc"}}}},
        {"id": "b", "kind": "split_lines", "in": {"text": {"ref": "a"}}},
        {"id": "c", "kind": "create_tasks", "in": {"text": {"ref": "b"}, "project": {"literal": {"project": "errands"}}}}
      ],
      "expect": {"created": [{"title": "apples", "project_id": "errands"}, {"title": "oat milk", "project_id": "errands"}]}
    },
    {
      "row": 7,
      "name": "When a task gets the label waiting, count my waiting tasks and notify me when there are more than 10",
      "labels": [{"id": "lw", "name": "waiting"}],
      "tasks": [{"id": "w0", "labels": ["lw"]}, {"id": "w1", "labels": ["lw"]}, {"id": "w2", "labels": ["lw"]}, {"id": "w3", "labels": ["lw"]}, {"id": "w4", "labels": ["lw"]}, {"id": "w5", "labels": ["lw"]},
        {"id": "w6", "labels": ["lw"]}, {"id": "w7", "labels": ["lw"]}, {"id": "w8", "labels": ["lw"]}, {"id": "w9", "labels": ["lw"]}, {"id": "w10", "labels": ["lw"]}],
      "trigger": {"kind": "label.added", "label_id": "lw"}, "run_on": "w0",
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"labels": {"any": ["lw"]}}}}},
        {"id": "b", "kind": "count", "in": {"list": {"ref": "a"}}},
        {"id": "c", "kind": "if", "in": {"value": {"ref": "b"}, "is": {"literal": {">": 10}}}, "then": [
          {"id": "d", "kind": "notify", "in": {"text": {"literal": {"format": "{b} waiting"}}}}]}
      ],
      "expect": {"notices": ["11 waiting"]}
    },
    {
      "row": 8,
      "name": "Every morning, move what is overdue to today and send the list to my webhook",
      "seed": "overdue", "webhooks": ["w1"],
      "trigger": {"kind": "schedule", "at": "07:00", "weekdays": [1, 2, 3, 4, 5]}, "condition": {"due": "overdue"},
      "steps": [
        {"id": "a", "kind": "change_tasks", "in": {"tasks": {"ref": "trigger"}, "set": {"literal": {"due": "today"}}}},
        {"id": "b", "kind": "webhook", "in": {"webhook_id": {"literal": "w1"}, "tasks": {"ref": "a"}}}
      ],
      "expect": {
        "changed": {"o1": {"due": "2026-10-21"}, "o2": {"due": "2026-10-21"}, "o3": {"due": "2026-10-21"}, "o4": {"due": "2026-10-21"}},
        "webhooks": [{"tasks": ["o1", "o2", "o3", "o4"]}]
      }
    },
    {
      "row": 9,
      "name": "Sunday overdue sweep (starter)",
      "seed": "overdue",
      "trigger": {"kind": "schedule", "at": "18:00", "weekdays": [7]}, "condition": {"due": "overdue"},
      "steps": [
        {"id": "a", "kind": "change_tasks", "in": {"tasks": {"ref": "trigger"}, "set": {"literal": {"due": "tomorrow"}}}},
        {"id": "b", "kind": "count", "in": {"list": {"ref": "a"}}},
        {"id": "c", "kind": "notify", "in": {"text": {"literal": {"format": "{b} tasks moved to Monday"}}}}
      ],
      "expect": {
        "changed": {"o1": {"due": "2026-10-22"}, "o2": {"due": "2026-10-22"}, "o3": {"due": "2026-10-22"}, "o4": {"due": "2026-10-22"}},
        "notices": ["4 tasks moved to Monday"]
      }
    },
    {
      "row": 10, "editor": true,
      "name": "Waiting follow-up (starter): comment Waiting since today and set it due in 3 days",
      "labels": [{"id": "lw", "name": "waiting"}],
      "tasks": [{"id": "w0", "labels": ["lw"]}],
      "trigger": {"kind": "label.added", "label_id": "lw"}, "run_on": "w0",
      "steps": [
        {"id": "a", "kind": "date", "in": {"date": {"literal": "today"}}},
        {"id": "b", "kind": "add_comment", "in": {"task": {"ref": "trigger"}, "text": {"literal": {"format": "Waiting since {a}"}}}},
        {"id": "c", "kind": "change_tasks", "in": {"tasks": {"ref": "trigger"}, "set": {"literal": {"due": {"in_days": 3}}}}}
      ],
      "expect": {"comments": {"w0": ["Waiting since 2026-10-21"]}, "changed": {"w0": {"due": "2026-10-24"}}}
    },
    {
      "row": 11,
      "name": "Friday digest (starter): email me what I completed this week",
      "email": true,
      "tasks": [{"id": "c1", "completed_on": "2026-10-20"}, {"id": "c2", "completed_on": "2026-10-21"}, {"id": "c3", "completed_on": "2026-10-10"}, {"id": "x1"}],
      "trigger": {"kind": "schedule", "at": "16:00", "weekdays": [5]},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"query": {"literal": "completed = this week"}}},
        {"id": "b", "kind": "count", "in": {"list": {"ref": "a"}}},
        {"id": "c", "kind": "format", "in": {"template": {"literal": "{b} done:\n{a}"}}},
        {"id": "d", "kind": "email_me", "in": {"subject": {"literal": "This week"}, "text": {"ref": "c"}}}
      ],
      "expect": {"emails": [{"subject": "This week", "text": "2 done:\nc1\nc2"}]}
    },
    {
      "row": 12,
      "name": "Morning focus (starter): the three highest-priority tasks due today",
      "tasks": [{"id": "f0", "due": "2026-10-21", "priority": 3}, {"id": "f1", "due": "2026-10-21", "priority": 1}, {"id": "f2", "due": "2026-10-21", "priority": 4}, {"id": "f3", "due": "2026-10-21", "priority": 2}],
      "trigger": {"kind": "schedule", "at": "07:30", "weekdays": [1, 2, 3, 4, 5]},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "today"}}}},
        {"id": "b", "kind": "sort", "in": {"list": {"ref": "a"}, "by": {"literal": "priority"}}},
        {"id": "c", "kind": "take", "in": {"list": {"ref": "b"}, "n": {"literal": 3}}},
        {"id": "d", "kind": "set_focus", "in": {"tasks": {"ref": "c"}}}
      ],
      "expect": {"focus": "f1,f3,f0"}
    },
    {
      "row": 13,
      "name": "Inbox over 20 (starter): notify me when the Inbox has more than 20 tasks",
      "tasks": [{"id": "i0"}, {"id": "i1"}, {"id": "i2"}, {"id": "i3"}, {"id": "i4"}, {"id": "i5"}, {"id": "i6"}, {"id": "i7"}, {"id": "i8"}, {"id": "i9"}, {"id": "i10"},
        {"id": "i11"}, {"id": "i12"}, {"id": "i13"}, {"id": "i14"}, {"id": "i15"}, {"id": "i16"}, {"id": "i17"}, {"id": "i18"}, {"id": "i19"}, {"id": "i20"}],
      "trigger": {"kind": "schedule", "at": "09:00", "weekdays": [1, 2, 3, 4, 5]},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"query": {"literal": "no project"}}},
        {"id": "b", "kind": "count", "in": {"list": {"ref": "a"}}},
        {"id": "c", "kind": "if", "in": {"value": {"ref": "b"}, "is": {"literal": {">": 20}}}, "then": [
          {"id": "d", "kind": "notify", "in": {"text": {"literal": {"format": "Inbox has {b} tasks"}}}}]}
      ],
      "expect": {"notices": ["Inbox has 21 tasks"]}
    },
    {
      "row": 15, "editor": true,
      "name": "Meeting notes (starter): the open checkboxes of the task's note become tasks in its project",
      "projects": [{"id": "work", "name": "Work"}],
      "tasks": [{"id": "m1", "title": "Planning meeting", "project_id": "work", "description": "- [ ] book room\n- notes\n- [x] done already\n- [ ] send agenda"}],
      "trigger": {"kind": "manual"}, "run_on": "m1",
      "steps": [
        {"id": "a", "kind": "note_text", "in": {"of": {"ref": "trigger"}}},
        {"id": "b", "kind": "split_lines", "in": {"text": {"ref": "a"}, "only": {"literal": "open_checkboxes"}}},
        {"id": "c", "kind": "project_of", "in": {"task": {"ref": "trigger"}}},
        {"id": "d", "kind": "create_tasks", "in": {"text": {"ref": "b"}, "project": {"ref": "c"}}}
      ],
      "expect": {"created": [{"title": "book room", "project_id": "work"}, {"title": "send agenda", "project_id": "work"}]}
    },
