{
  "about": "The use-case suite of OpenSpec change routines-dynamic-data (design D12): realistic routines, each run by internal/rules (usecases_test.go) against seeded data with the expected writes, type-checked by the TypeScript checker (usecases.test.ts) and planned by the device's planner (run/usecases.test.ts, routines-ai-step D7). The clock is Wednesday 2026-10-21 12:00 UTC; tasks are listed in seed order (position). Seed tasks take title = id unless given; due and completed_on are dates. entries are time entries of the user (started, ended as RFC 3339; no end runs). ai lists the model's answers in call order ({text} or {lines}); a case with ai runs with Apply without asking on. changed_projects, created_projects, sections (\"Project/Section\"), labels_created and favourites are compared when a case states them.",
  "seeds": {
    "overdue": {
      "tasks": [
        {"id": "o1", "due": "2026-10-18"},
        {"id": "o2", "due": "2026-10-15"},
        {"id": "o3", "due": "2026-10-19"},
        {"id": "o4", "due": "2026-10-20"},
        {"id": "f1", "due": "2026-10-25"}
      ]
    }
  },
  "cases": [
    {
      "row": 1, "editor": true,
      "name": "When I run it, find my overdue tasks, pick the first, and comment",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "take", "in": {"list": {"ref": "a"}, "n": {"literal": 1}, "from": {"literal": "start"}}},
        {"id": "c", "kind": "add_comment", "in": {"task": {"ref": "b"}, "text": {"literal": "Still on it?"}}}
      ],
      "expect": {"comments": {"o1": ["Still on it?"]}}
    },
    {
      "row": 2, "editor": true,
      "name": "Same, but the last one",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "take", "in": {"list": {"ref": "a"}, "n": {"literal": 1}, "from": {"literal": "end"}}},
        {"id": "c", "kind": "add_comment", "in": {"task": {"ref": "b"}, "text": {"literal": "Still on it?"}}}
      ],
      "expect": {"comments": {"o4": ["Still on it?"]}}
    },
    {
      "row": 3, "editor": true,
      "name": "Same, on all of them (Pick all)",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "take", "in": {"list": {"ref": "a"}, "from": {"literal": "all"}}},
        {"id": "c", "kind": "add_comment", "in": {"task": {"ref": "b"}, "text": {"literal": "Still on it?"}}}
      ],
      "expect": {"comments": {"o1": ["Still on it?"], "o2": ["Still on it?"], "o3": ["Still on it?"], "o4": ["Still on it?"]}}
    },
    {
      "row": 3,
      "name": "Same, on all of them, straight from Find tasks",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "add_comment", "in": {"task": {"ref": "a"}, "text": {"literal": "Still on it?"}}}
      ],
      "expect": {"comments": {"o1": ["Still on it?"], "o2": ["Still on it?"], "o3": ["Still on it?"], "o4": ["Still on it?"]}}
    },
    {
      "row": 4, "editor": true,
      "name": "Same, on the three most overdue",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "sort", "in": {"list": {"ref": "a"}, "by": {"literal": "due"}, "direction": {"literal": "asc"}}},
        {"id": "c", "kind": "take", "in": {"list": {"ref": "b"}, "n": {"literal": 3}, "from": {"literal": "start"}}},
        {"id": "d", "kind": "add_comment", "in": {"task": {"ref": "c"}, "text": {"literal": "Still on it?"}}}
      ],
      "expect": {"comments": {"o1": ["Still on it?"], "o2": ["Still on it?"], "o3": ["Still on it?"]}}
    },
    {
      "row": 5, "editor": true,
      "name": "Find my overdue tasks, and for each: comment",
      "seed": "overdue",
      "trigger": {"kind": "manual"},
      "steps": [
        {"id": "a", "kind": "find_tasks", "in": {"condition": {"literal": {"due": "overdue"}}}},
        {"id": "b", "kind": "repeat", "in": {"list": {"ref": "a"}}, "do": [
          {"id": "c", "kind": "add_comment", "in": {"task": {"ref": "item"}, "text": {"literal": "Still on it?"}}}]}
      ],
      "expect": {"comments": {"o1": ["Still on it?"], "o2": ["Still on it?"], "o3": ["Still on it?"], "o4": ["Still on it?"]}}
    },
