registry=https://registry.npmjs.org/
loglevel=warn
save-exact=true
# Install only releases at least 7 days old (npm 11.10 or newer; older npm ignores
# it): a hijacked release is usually found and pulled within days. The lockfile
# pins exact versions, so npm ci is unaffected; Dependabot waits the same 7 days.
min-release-age=7
