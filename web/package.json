{
  "name": "opentodo-web",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "predev": "npm run --silent help",
    "dev": "vite",
    "prebuild": "npm run --silent help",
    "build": "node -e \"require('node:fs').rmSync('../internal/web/dist/assets', { recursive: true, force: true })\" && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build && node scripts/app-manifest.mjs",
    "preview": "vite preview",
    "pretest": "npm run --silent help",
    "test": "vitest run",
    "test:built": "REQUIRE_BUILT=1 vitest run src/lib/serviceWorker.test.ts src/ui/workbench.test.ts",
    "pretest:perf": "npm run --silent help",
    "test:perf": "vitest run -c vitest.perf.config.ts",
    "pretest:contract": "npm run --silent help",
    "test:contract": "vitest run -c vitest.contract.config.ts",
    "test:contract:record": "RECORD_V1_CLIENTS=1 vitest run -c vitest.contract.config.ts",
    "nlp:vocab": "UPDATE_QUICKADD_VOCAB=1 vitest run src/lib/nlp/vocab.test.ts",
    "lint": "eslint --max-warnings 0 src",
    "pretypecheck": "npm run --silent help",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "docs:build": "node scripts/docs/build.mjs",
    "docs:check": "node scripts/docs/check.mjs",
    "help": "node scripts/docs/help.mjs",
    "prestorybook": "npm run --silent help",
    "storybook": "storybook dev -p 6006 --no-open",
    "prebuild-storybook": "npm run --silent help",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "ui:check": "node ../scripts/ui-check.mjs"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "maplibre-gl": "6.16.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.9",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "6.2.4",
    "use-stick-to-bottom": "1.1.6",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "marked": "18.1.2",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
