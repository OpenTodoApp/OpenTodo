{
  "name": "opentodo-web",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('node:fs').rmSync('../internal/web/dist/assets', { recursive: true, force: true })\" && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "nlp:vocab": "UPDATE_QUICKADD_VOCAB=1 vitest run src/lib/nlp/vocab.test.ts",
    "lint": "eslint --max-warnings 0 src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "docs:build": "node scripts/docs/build.mjs",
    "docs:check": "node scripts/docs/check.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "ui:check": "node ../scripts/ui-check.mjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "maplibre-gl": "6.12.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.1",
    "marked": "18.1.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
